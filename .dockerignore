# Keep the frontend Docker build context small and secret-free.
# (VITE_* values come from Dockerfile.prod ARGs, GEMINI_API_KEY at runtime.)
node_modules/
dist/
.git/
.idea/
.vscode/
.env
.env.local
.env.*.local
# Excluded so Dockerfile.prod build ARGs are the single source of truth
# for VITE_* (Vite prefers process env over dotenv files anyway).
.env.production
npm-debug.log
